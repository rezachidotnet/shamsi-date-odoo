<odoo>

    <record id="calendar_event_form_jalali" model="ir.ui.view">
        <field name="name">calendar.event.form.jalali</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>

        <field name="arch" type="xml">

            <!-- normal events -->
        <xpath expr="//field[@name='start']" position="after">
            <!-- blank space -->
            <div class="o_jalali_blank" style="height:8px;"></div>  

            <!-- Jalali dates row -->
            <div class="o_jalali_daterange_row d-flex align-items-center gap-2">
                <!-- start date matches start button width -->
                <div class="o_jalali_start_date text-muted flex-grow-1 text-start"></div>

                <!-- arrow matches main arrow -->
                <i class="fa fa-long-arrow-right mx-1" aria-label="Arrow icon" title="Arrow"></i>

                <!-- end date matches stop button width -->
                <div class="o_jalali_end_date text-muted flex-grow-1 text-start"></div>
            </div>
        </xpath>            <!-- all-day events -->
            <!-- <xpath expr="//field[@name='start_date']" position="after">
                <div class="o_jalali_allday text-muted"/>
            </xpath> -->
        </field>
    </record>

</odoo>