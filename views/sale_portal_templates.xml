<odoo>

    <template id="portal_sale_fa_customization"
              inherit_id="sale.sale_order_portal_content">

        <!-- ========================= -->
        <!-- Replace Order Date -->
        <!-- ========================= -->
        <xpath expr="//tbody[@id='sale_info_table']//span[@t-field='sale_order.date_order']"
               position="replace">

            <t t-if="request.env.lang == 'fa_IR'">
                <span t-esc="sale_order.date_order_shamsi"/>
            </t>
            <t t-else="">
                <span t-field="sale_order.date_order"
                      t-options="{'widget': 'date'}"/>
            </t>

        </xpath>

        <!-- ========================= -->
        <!-- Replace Expiration Date -->
        <!-- ========================= -->
        <xpath expr="//tbody[@id='sale_info_table']//span[@t-field='sale_order.validity_date']"
               position="replace">

            <t t-if="request.env.lang == 'fa_IR'">
                <span t-esc="sale_order.validity_date_shamsi"/>
            </t>
            <t t-else="">
                <span t-field="sale_order.validity_date"
                      t-options="{'widget': 'date'}"/>
            </t>

        </xpath>

        <!-- ========================= -->
        <!-- Replace Delivery Date (Commitment Date) -->
        <!-- ========================= -->
        <xpath expr="//tbody[@id='sale_info_table']//span[@t-field='sale_order.commitment_date']"
               position="replace">

            <t t-if="request.env.lang == 'fa_IR'">
                <span t-esc="sale_order.commitment_date_shamsi"/>
            </t>
            <t t-else="">
                <span t-field="sale_order.commitment_date"
                      t-options="{'widget': 'date'}"/>
            </t>

        </xpath>


        <!-- ========================= -->
        <!-- ۳. جایگزینی تاریخ تحویل (جدید) -->
        <!-- ========================= -->

        <xpath expr="//tbody[@id='sale_info_table']//span[@t-field='sale_order.commitment_date']" position="replace">
            <t t-if="request.env.lang == 'fa_IR'">
                <span t-esc="sale_order.commitment_date_shamsi"/>
            </t>
            <t t-else="">
                <span t-field="sale_order.commitment_date" t-options="{'widget': 'date'}"/>
            </t>
        </xpath>



        <!-- Insert quotation number BEFORE date row (Persian only) -->
        <xpath expr="//tbody[@id='sale_info_table']/tr[1]"
               position="before">

            <t t-if="request.env.lang == 'fa_IR'">
                <tr>
                    <th class="ps-0 pb-0">
                        شماره:
                    </th>
                    <td class="w-100 pb-0 text-wrap">
                        <span t-esc="sale_order.name"/>
                    </td>
                </tr>
            </t>

        </xpath>

        <!-- Replace H2 title -->
        <xpath expr="//div[@id='intro_row']/h2"
               position="replace">

            <h2>

                <!-- Persian -->
                <t t-if="request.env.lang == 'fa_IR'">
                    <t t-out="sale_order.type_name"/>
                </t>

                <!-- Other languages -->
                <t t-else="">
                    <t t-out="sale_order.type_name"/> -
                    <em t-out="sale_order.name"/>
                </t>

            </h2>

        </xpath>

    </template>

</odoo>